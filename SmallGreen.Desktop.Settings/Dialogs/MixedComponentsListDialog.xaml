<UserControl x:Class="SmallGreen.Desktop.Settings.Dialogs.MixedComponentsListDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Dialogs"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="550"
             MinWidth="550" MinHeight="350">

    <!-- 嵌套的 DialogHost 用于显示子对话框 -->
    <md:DialogHost Identifier="MixedComponentsListDialogHost">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="混合助剂列表"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BucketName, StringFormat=' - {0}'}"
                       FontSize="16"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Components DataGrid -->
        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Components}"
                  SelectedItem="{Binding SelectedComponent}"
                  VerticalScrollBarVisibility="Auto"
                  MaxHeight="300">

            <DataGrid.Columns>
                <DataGridTextColumn Width="100"
                                    Binding="{Binding CodeNumber}"
                                    Header="助剂编号"/>
                <DataGridTextColumn Width="150"
                                    Binding="{Binding Name}"
                                    Header="助剂名称"/>
                <DataGridTextColumn Width="100"
                                    Binding="{Binding Concentration, StringFormat={}{0:F2} g/L}"
                                    Header="助剂浓度"/>
                <DataGridTextColumn Width="80"
                                    Binding="{Binding Ratio, StringFormat={}{0:P2}}"
                                    Header="混合比例"/>

                <DataGridTemplateColumn Width="140" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.EditComponentCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="删除"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="Red"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DeleteComponentCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty State -->
        <TextBlock Grid.Row="2"
                   Text="暂无混合助剂"
                   FontStyle="Italic"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

                <Button Content="关闭"
        Style="{StaticResource MaterialDesignOutlinedButton}"
        Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
            
                <Button Content="添加助剂"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddComponentCommand}"
                    />
            
        </StackPanel>
        </Grid>
    </md:DialogHost>
</UserControl>
