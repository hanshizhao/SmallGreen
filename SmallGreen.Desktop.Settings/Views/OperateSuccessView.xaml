<UserControl x:Class="SmallGreen.Desktop.Settings.Views.OperateSuccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             Width="300"
             Height="250"
             d:DataContext="{d:DesignInstance Type=vm:OperateSuccessViewModel}"
             mc:Ignorable="d">
    <Border CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#ccc"
                    BorderThickness="0,0,0,1" />
            <TextBlock Grid.Row="0"
                       Margin="20,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="温馨提示" />

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Foreground="Black"
                    Opacity="0.6"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Close" />
            </Button>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                         Width="50"
                                         Height="50"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="#19b07e"
                                         Kind="CheckCircle" />

                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           d:Text="操作成功"
                           FontSize="25"
                           Text="{Binding Message}"
                           TextWrapping="WrapWithOverflow" />
            </Grid>

            <Button Grid.Row="2"
                    Height="50"
                    Margin="8"
                    Background="#0052d9"
                    BorderThickness="0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Content="好的" />
        </Grid>
    </Border>
</UserControl>
