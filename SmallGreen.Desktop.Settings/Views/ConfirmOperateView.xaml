<UserControl x:Class="SmallGreen.Desktop.Settings.Views.ConfirmOperateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConfirmOperateViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Border Background="White" CornerRadius="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17*" />
                <ColumnDefinition Width="63*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseWindowCommand}"
                    Foreground="Black"
                    Opacity="0.6"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Close" />
            </Button>

            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="#ccc"
                    BorderThickness="0,0,0,1" />
            <TextBlock Margin="20,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="温馨提示" />

            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                         Width="50"
                                         Height="50"
                                         Margin="0,40"
                                         HorizontalAlignment="Right"
                                         Foreground="#ffab40"
                                         Kind="Alert" />

                <TextBlock Grid.Column="1"
                           Margin="20,50,20,10"
                           d:Text="注意！退出系统后上料单元将无法正常使用。"
                           FontSize="20"
                           Text="{Binding Message}"
                           TextWrapping="WrapWithOverflow" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                <Button Width="100"
                        Height="40"
                        Background="#E7E7E7"
                        BorderBrush="#E7E7E7"
                        Command="{Binding CloseWindowCommand}"
                        Content="取消"
                        Foreground="#000" />

                <Button Width="100"
                        Height="40"
                        Margin="30,0,0,0"
                        Command="{Binding YesCommand}"
                        Content="确认" />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
