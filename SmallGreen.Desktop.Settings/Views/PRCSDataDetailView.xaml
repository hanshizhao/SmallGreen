<UserControl x:Class="SmallGreen.Desktop.Settings.Views.PRCSDataDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             Width="1366"
             Height="650"
             d:DataContext="{d:DesignInstance Type=vm:PRCSDataDetailViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="220" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                BorderBrush="#ccc"
                BorderThickness="0,1" />
        <TextBlock Grid.Row="0"
                   Margin="20,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="22"
                   Foreground="#666">
            <Run d:Text="[卡号]"
                 Foreground="{StaticResource NormalBrush}"
                 Text="{Binding Title}" />
            <Run Text="配料详情" />
        </TextBlock>

        <Button Grid.Row="0"
                HorizontalAlignment="Right"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                Foreground="#666"
                Style="{StaticResource MaterialDesignIconButton}">
            <materialDesign:PackIcon Kind="Close" />
        </Button>

        <Grid Grid.Row="1">
            <Grid.Resources>
                <Style x:Key="title" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="#666" />
                </Style>

                <Style x:Key="info" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="Foreground" Value="{StaticResource NormalBrush}" />
                    <Setter Property="Margin" Value="0,10,0,0" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style TargetType="StackPanel">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Margin" Value="5,0,0,0" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="卡号" />
                <TextBlock d:Text="手动模式"
                           Style="{StaticResource info}"
                           Text="{Binding PRCSDataDto.CardNo}" />
            </StackPanel>

            <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="机台" />
                <TextBlock Style="{StaticResource info}">
                    <Run Text="{Binding PRCSDataDto.EquipmentCodeNumber}" />
                    <Run Text="-" />
                    <Run Text="{Binding PRCSDataDto.EquipmentName}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="配液缸" />
                <TextBlock d:Text="未知"
                           Style="{StaticResource info}"
                           Text="{Binding PRCSDataDto.BulkCodeNumber}" />
            </StackPanel>

            <StackPanel Grid.Row="0"
                        Grid.Column="3"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="计划配液量" />
                <TextBlock Style="{StaticResource info}">
                    <Run d:Text="1000" Text="{Binding PRCSDataDto.PlanVolume}" />
                    <Run Text="升" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="0"
                        Grid.Column="4"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="实际配液量" />
                <TextBlock Style="{StaticResource info}">
                    <Run d:Text="1000" Text="{Binding PRCSDataDto.ActualVolume}" />
                    <Run Text="升" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="完成时间" />
                <TextBlock d:Text="2025-01-01 23:33:22"
                           Style="{StaticResource info}"
                           Text="{Binding PRCSDataDto.CompletedDateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource title}" Text="是否换单" />
                <TextBlock d:Text="2023-01-01 23:33:22"
                           Style="{StaticResource info}"
                           Text="{Binding PRCSDataDto.IsChange}" />
            </StackPanel>


        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Margin="10"
                       FontSize="20"
                       Foreground="#666"
                       Text="开料步骤详情" />

            <DataGrid Grid.Row="1"
                      Margin="5"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding ListDetail}">

                <DataGrid.Columns>
                    <DataGridTextColumn Width="0.7*"
                                        Binding="{Binding AssSequence}"
                                        Header="管道顺序" />
                    <DataGridTextColumn Width="0.7*"
                                        Binding="{Binding AssCodeNumber}"
                                        Header="助剂编号" />
                    <DataGridTextColumn Width="1.2*"
                                        Binding="{Binding AssName}"
                                        Header="助剂名称" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding GramsPerLiter, StringFormat={}{0:F2} g}"
                                        Header="每升含量(PLC)" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding EffectiveGramsPerLiter, StringFormat={}{0:F2} g}"
                                        Header="实际有效浓度" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding AssGl, StringFormat={}{0:F2} g/L}"
                                        Header="配方用量" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding PlanVolumeWithWater, StringFormat={}{0:F2} L}"
                                        Header="计划消耗体积" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding RealVolumeWithWater, StringFormat={}{0:F2} L}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource NormalBrush}"
                                        Header="实际消耗体积" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding PlanKg, StringFormat={}{0:F2} Kg}"
                                        Header="计划消耗量" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding AssKg, StringFormat={}{0:F2} Kg}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource NormalBrush}"
                                        Header="消耗量(含水)" />

                    <DataGridTextColumn Width="*"
                    Binding="{Binding EffectiveAssKg, StringFormat={}{0:F2} Kg}"
                    FontWeight="Bold"
                    Foreground="{StaticResource NormalBrush}"
                    Header="消耗量(无水)" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>
