<UserControl x:Class="SmallGreen.Desktop.Settings.Views.ErrorMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             Width="600"
             Height="300"
             d:DataContext="{d:DesignInstance Type=vm:ErrorMessageViewModel}"
             mc:Ignorable="d">
    <Border Background="#FFF1F0" CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#ccc"
                    BorderThickness="0,0,0,1" />
            <TextBlock Grid.Row="0"
                       Margin="20,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="出错了！" />

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseWindowCommand}"
                    Foreground="Black"
                    Opacity="0.6"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Close" />
            </Button>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                         Width="50"
                                         Height="50"
                                         Margin="0,38,0,0"
                                         HorizontalAlignment="Right"
                                         Foreground="#FF4D4F"
                                         Kind="CloseCircleOutline" />

                <ScrollViewer Grid.Column="1" Margin="10,40,30,5">
                    <TextBlock d:Text="错误消息"
                               FontSize="20"
                               Text="{Binding Message}"
                               TextWrapping="WrapWithOverflow" />
                </ScrollViewer>
            </Grid>

            <Button Grid.Row="2"
                    Width="100"
                    Height="40"
                    Margin="0,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#FF4D4F"
                    BorderBrush="#FF4D4F"
                    Command="{Binding CloseWindowCommand}"
                    Content="知道了" />
        </Grid>
    </Border>
</UserControl>
