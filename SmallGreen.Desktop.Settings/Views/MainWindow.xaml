<Window x:Class="SmallGreen.Desktop.Settings.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ext="clr-namespace:SmallGreen.Desktop.Settings.Extensions"
        xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
        Title="MainWindow"
        Width="1366"
        Height="768"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        prism:ViewModelLocator.AutoWireViewModel="True"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <materialDesign:DialogHost x:Name="DialogHost" Identifier="Root">
        <materialDesign:DrawerHost x:Name="DrawerHost" BottomDrawerCloseOnClickAway="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--  第一行 标题行  -->
                <Grid Grid.Row="0"
                      Background="White"
                      MouseLeftButtonDown="Grid_MouseLeftButtonDown">

                    <StackPanel Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Image Height="50"
                               Source="pack://application:,,,/Cowboy.Desktop.Settings;component/Assets/Images/lyLogo.png"
                               Stretch="Fill" />
                        <TextBlock Margin="5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource NormalBrush}"
                                   Text="不通过数据库维护小绿基本信息的桌面端程序" />
                    </StackPanel>


                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding ChangeUserPasswordCommand}" Style="{StaticResource MaterialDesignFlatLightButton}">
                            <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                <materialDesign:PackIcon Width="25"
                                                         Height="25"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="#666"
                                                         Kind="AccountCircleOutline" />
                                <TextBlock Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           d:Text="Admin"
                                           FontSize="14"
                                           Foreground="#666"
                                           Text="{Binding User.Username}" />
                            </StackPanel>
                        </Button>

                        <Button Click="Button_Click"
                                Foreground="#666"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="最小化">
                            <materialDesign:PackIcon Kind="Minimize" />
                        </Button>
                        <Button Click="Button_Click_1"
                                Foreground="#666"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="最大化">
                            <materialDesign:PackIcon x:Name="IconMax" Kind="Maximize" />
                        </Button>
                        <Button x:Name="btnClose"
                                Foreground="#666"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="退出系统">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                    </StackPanel>

                </Grid>

                <!--  第二行 菜单 内容  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--  第一列 菜单  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="65" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{StaticResource MaterialDesignDivider}" BorderThickness="0,1" />
                        <ScrollViewer Grid.Row="0"
                                      Margin="0,1"
                                      VerticalScrollBarVisibility="Hidden">
                            <ScrollViewer.Resources>
                                <!--  item样式  -->
                                <Style TargetType="RadioButton">
                                    <Setter Property="IsChecked" Value="False" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="back"
                                                        Height="35"
                                                        Margin="5"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5">
                                                    <TextBlock x:Name="pre"
                                                               Margin="49,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Foreground="#757575"
                                                               Text="{TemplateBinding Content}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="back" Property="Background" Value="#f3f3f3" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="true">
                                                        <Setter TargetName="back" Property="Background" Value="#0052b3" />
                                                        <Setter TargetName="pre" Property="Foreground" Value="White" />
                                                        <!--<Setter TargetName="_img" Property="Source" Value="/Images/rdo_yes.png" />-->
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style BasedOn="{StaticResource MaterialDesignExpander}" TargetType="Expander">
                                    <Setter Property="Foreground" Value="#757575" />
                                    <Style.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter Property="Foreground" Value="#000" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding ListMenu}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander HorizontalAlignment="Stretch"
                                                  Background="#fff"
                                                  IsExpanded="{Binding IsOpen, Mode=OneWay}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="20"
                                                                             Height="20"
                                                                             VerticalAlignment="Center"
                                                                             Kind="{Binding Icon}" />
                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Text="{Binding Title}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding SubItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.MenuClickCommand}"
                                                                     CommandParameter="{Binding .}"
                                                                     Content="{Binding Title}"
                                                                     GroupName="TestGroup"
                                                                     IsChecked="{Binding IsSelected, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ScrollViewer>
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#BBB"
                                   Text="孙哥必是意龙未来的总经理" />


                    </Grid>

                    <!--  第二列 内容  -->
                    <Grid Grid.Column="1" Background="#eeeeee">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="65" />
                        </Grid.RowDefinitions>
                        <!--  VerticalOffset  -->
                        <ContentControl Margin="10" prism:RegionManager.RegionName="{x:Static ext:PrismManager.MainViewRegionName}" />


                        <Border Grid.Row="1" Background="#eee">
                            <TextBlock Grid.Row="0"
                                       Margin="5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Opacity="0.5"
                                       Text="Copyright @ 2024-2025 孙哥 版权所有" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
