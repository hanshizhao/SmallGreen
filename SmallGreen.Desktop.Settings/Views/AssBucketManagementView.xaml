<UserControl x:Class="SmallGreen.Desktop.Settings.Views.AssBucketManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AssBucketManagementViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,8">
            <Button Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  Margin="8,0,8,8"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Buckets}"
                  SelectedItem="{Binding SelectedBucket}">

            <DataGrid.Columns>
                <!-- 所属系统 -->
                <DataGridTextColumn Width="*"
                                    MinWidth="80"
                                    Binding="{Binding SubSystemName}"
                                    Header="所属系统"/>

                <!-- 管道顺序 -->
                <DataGridTextColumn Width="*"
                                    MinWidth="60"
                                    Binding="{Binding Sequence}"
                                    Header="管道顺序"/>

                <!-- 编号 -->
                <DataGridTextColumn Width="*"
                                    MinWidth="80"
                                    Binding="{Binding CodeNumber}"
                                    Header="编号"/>

                <!-- 名称 -->
                <DataGridTextColumn Width="2*"
                                    MinWidth="120"
                                    Binding="{Binding Name}"
                                    Header="名称"/>

                <!-- 浓度 -->
                <DataGridTextColumn Width="*"
                                    MinWidth="80"
                                    Binding="{Binding Concentration, StringFormat={}{0:F2} g/L}"
                                    Header="浓度"/>

                <DataGridTextColumn Width="*"
                    MinWidth="80"
                    Binding="{Binding EffectiveConcentration, StringFormat={}{0:F2} g/L}"
                    Header="有效浓度"/>

                <!-- 最大容量 -->
                <DataGridTextColumn Width="*"
                                    MinWidth="80"
                                    Binding="{Binding MaxV, StringFormat={}{0:F0} L}"
                                    Header="最大容量"/>

                <!-- 是否混合 + 查看组分按钮 -->
                <DataGridTemplateColumn Width="*" MinWidth="120" Header="是否混合">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsMixed, Mode=OneWay}"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"/>
                                <Button Content="查看"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4,0"
                                        Visibility="{Binding IsMixed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.ViewComponentsCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip="查看混合组分"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 编辑按钮 -->
                <DataGridTemplateColumn Width="*" MinWidth="60" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="编辑"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditBucketCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
