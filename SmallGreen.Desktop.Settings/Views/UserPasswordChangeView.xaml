<UserControl x:Class="SmallGreen.Desktop.Settings.Views.UserPasswordChangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pass="clr-namespace:SmallGreen.Desktop.Settings.Extensions"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:UserPasswordChangeViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="350"
             mc:Ignorable="d">
    <Grid Width="350"
          Height="300"
          TextBlock.FontSize="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="46" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--  第一行 条子  -->
        <Grid Grid.Row="0" Background="{StaticResource NormalBrush}" />

        <!--  第二行 标题  -->
        <Grid Grid.Row="1">

            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       d:Text="修改密码"
                       FontSize="18"
                       Foreground="{StaticResource NormalBrush}"
                       Text="{Binding Title}" />

            <Button Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseWindowCommand}"
                    Content="{materialDesign:PackIcon Kind=Close,
                                                      Size=30}"
                    Foreground="#000"
                    Opacity="0.4"
                    Style="{StaticResource MaterialDesignIconButton}" />
            <Border BorderBrush="{StaticResource MaterialDesignDivider}" BorderThickness="0,0,0,1" />
        </Grid>

        <!--  内容  -->
        <Grid Grid.Row="2">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,3,0" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style BasedOn="{StaticResource VivaPasswordStyle}" TargetType="PasswordBox">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="Width" Value="200" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Margin" Value="3,0,0,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="25" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="旧密码：" />

            <PasswordBox Grid.Row="0"
                         Grid.Column="1"
                         pass:PassWordExtensions.PassWord="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="请输入旧密码">
                <i:Interaction.Behaviors>
                    <pass:PasswordBehavior />
                </i:Interaction.Behaviors>
            </PasswordBox>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="新密码：" />

            <PasswordBox Grid.Row="1"
                         Grid.Column="1"
                         pass:PassWordExtensions.PassWord="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="请输入新密码">
                <i:Interaction.Behaviors>
                    <pass:PasswordBehavior />
                </i:Interaction.Behaviors>
            </PasswordBox>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="确认密码：" />


            <PasswordBox Grid.Row="2"
                         Grid.Column="1"
                         pass:PassWordExtensions.PassWord="{Binding ComfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="请输入确认密码">
                <i:Interaction.Behaviors>
                    <pass:PasswordBehavior />
                </i:Interaction.Behaviors>
            </PasswordBox>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       d:Text="错误消息"
                       Foreground="{StaticResource ErrorBrush}"
                       Text="{Binding ErrorMessage}" />

            <StackPanel Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Width="100"
                        Height="35"
                        Margin="30,0"
                        Command="{Binding SaveCommand}"
                        Content="保存" />
                <Button Width="100"
                        Height="35"
                        Margin="30,0"
                        BorderBrush="#666"
                        Command="{Binding CloseWindowCommand}"
                        Content="取消"
                        Foreground="#666"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
