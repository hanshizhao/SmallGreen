<UserControl x:Class="SmallGreen.Desktop.Settings.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SmallGreen.Desktop.Settings.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pass="clr-namespace:SmallGreen.Desktop.Settings.Extensions"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:SmallGreen.Desktop.Settings.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Width="740" Background="Transparent">
        <Border Width="330"
                HorizontalAlignment="Right"
                Background="#F7F9FA"
                BorderBrush="#DDD"
                BorderThickness="0"
                CornerRadius="0,5,5,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  Direction="0"
                                  Opacity="0.2"
                                  ShadowDepth="0"
                                  Color="#000" />
            </Border.Effect>

            <Grid Margin="60,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="auto" MinHeight="40" />
                </Grid.RowDefinitions>

                <!--  关闭按钮  -->
                <Button Grid.Row="0"
                        Margin="0,0,-20,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CloseWindowCommand}"
                        CommandParameter="{Binding ., RelativeSource={RelativeSource AncestorType=Window}}"
                        Foreground="#999"
                        Style="{StaticResource MaterialDesignIconButton}">
                    <materialDesign:PackIcon Width="25"
                                             Height="25"
                                             Kind="Close" />
                </Button>

                <!--  介绍文字  -->
                <StackPanel Grid.Row="1">
                    <TextBlock FontSize="22"
                               Foreground="{StaticResource NormalBrush}"
                               Text="卧龙与凤雏" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="#888"
                               Text="得一可安天下也......" />
                </StackPanel>

                <!--  用户名文本框  -->
                <TextBox Grid.Row="3"
                         Height="30"
                         Margin="0,10"
                         materialDesign:HintAssist.Hint="请输入用户名"
                         DockPanel.Dock="Top"
                         FontSize="16"
                         Text="{Binding UserName}" />

                <!--  密码框  -->
                <PasswordBox Grid.Row="4"
                             Height="30"
                             Margin="0,10"
                             materialDesign:HintAssist.Hint="请输入密码"
                             pass:PassWordExtensions.PassWord="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             DockPanel.Dock="Top"
                             FontSize="16">
                    <i:Interaction.Behaviors>
                        <pass:PasswordBehavior />
                    </i:Interaction.Behaviors>
                </PasswordBox>

                <CheckBox Grid.Row="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Content="记住账号"
                          FontSize="16"
                          IsChecked="{Binding IsSave}" />

                <!--  忘记密码  -->
                <TextBlock Grid.Row="5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="Collapsed">
                    <Hyperlink>忘记密码</Hyperlink>
                </TextBlock>

                <!--  登录按钮  -->
                <Button Grid.Row="6"
                        Height="40"
                        Margin="0,8"
                        Background="{StaticResource NormalBrush}"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="登    录"
                        Foreground="White" />

                <!--  错误信息  -->
                <TextBlock Grid.Row="7"
                           Margin="0,5"
                           HorizontalAlignment="Center"
                           d:Text="用户名或密码错误"
                           FontSize="16"
                           Foreground="{StaticResource ErrorBrush}"
                           LineHeight="23"
                           Text="{Binding Message, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Polygon HorizontalAlignment="Left" Points="0 0, 420, 0, 450 200 420 400 0 400">
            <Polygon.Fill>
                <ImageBrush ImageSource="pack://application:,,,/SmallGreen.Desktop.Settings;component/Assets/Images/login_image.jpg"
                            Stretch="UniformToFill"
                            Viewbox="0,0,1.4,1" />
            </Polygon.Fill>
            <Polygon.Effect>
                <DropShadowEffect BlurRadius="10"
                                  Direction="0"
                                  Opacity="0.5"
                                  ShadowDepth="5"
                                  Color="Black" />
            </Polygon.Effect>
        </Polygon>

    </Grid>
</UserControl>
